# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database and authentication (use long random values; never commit .env)
DATABASE_URL=postgresql://skyforge:change-me@localhost:5432/skyforge
JWT_SECRET=
FIELD_ENCRYPTION_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# Optional AI planner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AWS account hosting the SkyForge API/worker (required for customer role onboarding; not the customer's account)
SKYFORGE_AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1
# Optional single-account platform credentials; prefer per-user IAM roles
# AWS_ACCOUNT_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Configure both together to reuse an existing network:
# AWS_VPC_ID=vpc-...
# AWS_SUBNET_IDS=subnet-...,subnet-...

# Only enable when the API is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=false

# Keep false for multi-user production. Inline jobs are development-only.
ALLOW_INLINE_JOBS=true
ALLOW_PLATFORM_AWS=false
ALLOW_CUSTOM_HEALTH_HOSTS=false
LOG_REDIS_ERRORS=false

# Build/runtime controls
BUILD_TIMEOUT_MS=600000
PUSH_TIMEOUT_MS=900000
ECS_WAIT_SECONDS=900
# Used only when tearing down legacy S3/CloudFront releases
CLOUDFRONT_WAIT_SECONDS=900
DESTROY_VERIFY_ATTEMPTS=8
DEPLOYMENT_WORKER_CONCURRENCY=1

# Set true only when one process should serve ../client/dist
SERVE_CLIENT=false

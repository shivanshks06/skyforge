generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  github        GitHubAccount?
  projects      Project[]
  awsConnection AwsConnection?
  alertSettings Json?
  budget        Json?
}

model GitHubAccount {
  id          String @id @default(cuid())
  githubId    String @unique
  username    String
  accessToken String
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id])
}

model Project {
  id               String       @id @default(cuid())
  name             String
  repoName         String
  branch           String       @default("main")
  framework        String?
  language         String?
  packageManager   String?
  buildTool        String?
  buildCommand     String?
  startCommand     String?
  port             Int?
  dockerized       Boolean      @default(false)
  requiredEnv      String[]
  envAnalysis      Json?
  securityTier     String       @default("FREE")
  securityReport   Json?
  protection       Json?
  siteOffline      Boolean      @default(false)
  databaseConfig   Json?
  buildMode        String       @default("local")
  autoDeploy       Boolean      @default(false)
  previewsEnabled  Boolean      @default(false)
  parentProjectId  String?
  previewPr        Int?
  gitWatch         Json?
  customDomain     Json?
  statusPage       Json?
  deploymentTarget String?
  confidence       Int?
  status           String       @default("Imported")
  configVersion    Int          @default(0)
  githubUrl        String
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  deployments      Deployment[]
  securityEvents   SecurityEvent[]
  uptime           UptimeBucket[]

  // Sprint 5 Planning & Blueprint fields
  cpu            String?
  memory         String?
  healthCheck    String?
  deploymentPlan Json?
  envConfig      Json?

  // Sprint 6 Containerization & Docker Strategy fields
  dockerStrategy   String? @default("GENERATE")
  dockerGenerated  Boolean @default(false)
  dockerPath       String?
  dockerValidation Json?

  // Sprint 7 Infrastructure & Terraform fields
  infrastructureManifest Json?
  terraformGenerated     Boolean @default(false)
  terraformPath          String?
  estimatedCost          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@index([parentProjectId])
}

// Sprint 8 AWS Connection Model (Zero static secret keys; STS AssumeRole only)
model AwsConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleArn         String?
  externalId      String?
  accountId       String?
  region          String   @default("ap-south-1")
  accessKeyId     String?
  secretAccessKey String?
  sessionToken    String?
  authType        String   @default("ROLE_ARN") // "ACCESS_KEYS" or "ROLE_ARN"
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

// Sprint 8 & 9 Real-Time Asynchronous Deployment Queue & Worker Model
model Deployment {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String    @default("QUEUED")
  stage        String    @default("QUEUED")
  currentStep  String?   @default("QUEUED")
  liveUrl      String?
  healthStatus String?   @default("UNKNOWN")
  latencyMs    Int?
  logs         Json?
  error        String?
  target       String?
  configVersion Int?
  resources    Json?
  artifactPath String?
  workerJobId  String?   @unique
  retryOfId    String?
  rollbackOriginalStatus String?
  teardownResources      Json?
  teardownDeploymentIds  Json?
  trigger      String?
  commitSha    String?
  commitMessage String?
  commitAuthor String?
  stageTimings Json?
  restoredFromId String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

// Security incidents: what happened, what SkyForge did automatically, and who was alerted.
model SecurityEvent {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  severity  String
  title     String
  summary   String?
  detail    Json?
  actions   Json?
  alerts    Json?
  dedupeKey String?
  createdAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([projectId, createdAt])
  @@index([projectId, dedupeKey])
}

// Herd immunity: attacker IPs seen by any SkyForge project, shared with every Protected project.
model ThreatIntel {
  ip         String   @id
  hits       Int      @default(1)
  projectIds String[]
  reasons    String[]
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())

  @@index([lastSeen])
}

// Hourly uptime roll-up from the health monitor; feeds the public status page.
model UptimeBucket {
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hour         DateTime
  checks       Int      @default(0)
  failures     Int      @default(0)
  latencyTotal Int      @default(0)

  @@id([projectId, hour])
}
